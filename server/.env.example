# Copy to .env for local development; set the same variables on Railway.

# --- Required ---------------------------------------------------------------

# The client app's public URL. Emailed links point here, Google returns here,
# and its origin is the one trusted for writes (Netlify proxies /api/* to us).
APP_URL=http://localhost:5173

DATABASE_URL=postgres://postgres:postgres@localhost:5432/mit8333

# Mail: Mailpit in development, Brevo SMTP in production.
#   Brevo: smtp://<login>:<smtp-key>@smtp-relay.brevo.com:587
SMTP_URL=smtp://localhost:1025
MAIL_FROM="MIT 8333 Maintenance <no-reply@example.com>"

# "Continue with Google": an OAuth client from Google Cloud Console, with
# ${APP_URL}/api/auth/oidc/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional ---------------------------------------------------------------

PORT=3000

# Mail provider: only `smtp` today (see src/mail/mail-transport.ts).
# MAIL_TRANSPORT=smtp

# Proxies in front of the API that append to X-Forwarded-For. Production:
# Netlify, then Railway's edge = 2. Local development: 0.
TRUST_PROXY_HOPS=0

# Set to false if the client's IP doesn't reach the API through the proxies,
# which turns the per-IP rate limits off (docs/auth-module.md).
# RATE_LIMIT_BY_IP=true

# Plain-HTTP test runs only. Browsers accept Secure cookies on localhost.
# COOKIE_SECURE=true

# Demo accounts for markers (`npm run db:seed`): administrator@, officer@,
# student@ and staff@ this domain, all with this password, which must meet
# the password rules.
DEMO_ACCOUNTS_DOMAIN=demo.mit8333.example
DEMO_ACCOUNTS_PASSWORD=

# NestJS Observe (`npx @nestjs/observe link` writes these).
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
