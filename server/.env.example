# Host-run API settings: copy to .env for local development or set on Railway.
# Supply the S3 settings to Docker Compose too; see ../README.md.
# Optional Google/demo values can be supplied with --env-file server/.env.

# --- Required ---------------------------------------------------------------

# The client app's public URL. Emailed links point here, Google returns here,
# and its origin is the one trusted for writes (Netlify proxies /api/* to us).
APP_URL=http://localhost:5173

DATABASE_URL=postgres://postgres:postgres@localhost:5432/mit8333

# Private photo bucket, shared by local development and production.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Required relative key prefix; use prod/ in production. No NODE_ENV inference.
S3_KEY_PREFIX=dev/

# Mail: Mailpit in development, Brevo SMTP in production.
#   Brevo: smtp://<login>:<smtp-key>@smtp-relay.brevo.com:587
SMTP_URL=smtp://localhost:1025
# Omit for transport defaults: STARTTLS is required for non-loopback hosts.
# The root Compose stack explicitly selects opportunistic for trusted Mailpit.
# SMTP_STARTTLS=opportunistic
MAIL_FROM="MIT 8333 Maintenance <no-reply@example.com>"

# "Continue with Google": an OAuth client from Google Cloud Console, with
# ${APP_URL}/api/auth/oidc/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# S3-compatible stores can override the endpoint and addressing style.
# S3_ENDPOINT=https://s3.example.com
# S3_FORCE_PATH_STYLE=false

# --- Optional ---------------------------------------------------------------

# development | test | production. Under `test` the .env file is ignored.
NODE_ENV=development

PORT=3000

# Mail provider: only `smtp` today (see src/mail/mail-transport.ts).
# MAIL_TRANSPORT=smtp

# Proxies in front of the API that append to X-Forwarded-For. Production:
# Netlify, then Railway's edge = 2. Local development: 0.
TRUST_PROXY_HOPS=0

# Set to false if the client's IP doesn't reach the API through the proxies,
# which turns the per-IP rate limits off (docs/auth-module.md).
# RATE_LIMIT_BY_IP=true

# Plain-HTTP local containers/tests set this false; use true with HTTPS.
# COOKIE_SECURE=true

# Demo accounts for markers (`npm run db:seed`): administrator@, officer@,
# student@ and staff@ this domain, all with this password, which must meet
# the password rules.
DEMO_ACCOUNTS_DOMAIN=demo.mit8333.example
DEMO_ACCOUNTS_PASSWORD=

# NestJS Observe (`npx @nestjs/observe link` writes these).
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
